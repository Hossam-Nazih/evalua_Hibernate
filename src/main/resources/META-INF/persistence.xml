<persistence xmlns="http://xmlns.jcp.org/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/persistence
             http://xmlns.jcp.org/xml/ns/persistence/persistence_2_2.xsd"
             version="2.2">

    <!-- seule unite de persistance du projet, ouverte une fois par JpaUtil -->
    <persistence-unit name="defaultPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- catalogue et utilisateurs -->
        <class>org.example.entities.Categorie</class>
        <class>org.example.entities.Produit</class>
        <class>org.example.entities.User</class>
        <class>org.example.entities.Client</class>
        <class>org.example.entities.Fournisseur</class>
        <!-- ventes : commandes, lignes, factures et reglements -->
        <class>org.example.entities.Commande</class>
        <class>org.example.entities.CommandeProduit</class>
        <class>org.example.entities.Facture</class>
        <class>org.example.entities.Paiement</class>

        <properties>
            <!-- H2 en memoire : la base vit aussi longtemps que la JVM (DB_CLOSE_DELAY=-1) -->
            <property name="javax.persistence.jdbc.driver" value="org.h2.Driver"/>
            <property name="javax.persistence.jdbc.url" value="jdbc:h2:mem:gestion_commerciale;DB_CLOSE_DELAY=-1"/>
            <property name="javax.persistence.jdbc.user" value="sa"/>
            <property name="javax.persistence.jdbc.password" value=""/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect"/>
            <!-- le schema est genere a partir des annotations des entites -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <!-- trace des requetes SQL envoyees a H2 -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
